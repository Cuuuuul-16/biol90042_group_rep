# pipes 
# pipes make it easy to combine many functions together in R

# what does this code do?
my_vector <- c(1, 2, 3, 4)
as.character(round(mean(my_vector)))

# pipes can make this more readable
# pipes transport data from one function to the next
# R has two pipes %>% and |> 
# shortcut: cmd/control + shift + M
my_vector %>% mean() %>% round() %>% as.character()

# activity
# i want to sum the numbers 1-500 (hint: 1:500), take square root
# and then round the result to 2 decimal places. do this using pipes

1:500 %>% 
  sum() %>% 
  sqrt() %>% 
  round(digits = 2)

# how to work with our data
# tidyverse package called dplyr
# provide this info to google/ai when looking for help

# how to sort our data
# arrange()
dosage  %>%
  # arrange function sorts in ascending order by default
  # smallest to biggest
  arrange(weight_lost_g)

# to sort in descending order (biggest to smallest)
# use the desc() helper function
# helper functions are small functions that we don't usually
# use by themselves, but they help us to achieve some task
# together with another function

dosage %>%
  arrange(desc(weight_lost_g))

# slice_min() and slice_max()
# help us find the top n values of a column

# what are the top 5 highest weight lost by mice?
dosage %>%
  slice_max(weight_lost_g, n = 5, with_ties = FALSE)

# filtering our data
# filter() function + logical test == != > < etc.

# let's filter dosage data to just the Black 6 mice
# and then, find the three that lost the least weight
dosage %>%
  filter(mouse_strain == "Black 6") %>%
  slice_min(weight_lost_g, n = 3)

# & and | can be used to combine tests
# & means 'and'

# for example, CD-1 mice from cage 2B
dosage %>%
  filter(mouse_strain == "CD-1" & cage_number == "2B")
  

# use the | to mean 'or'
# all CD-1 mice, all mice in cage 2B
dosage %>%
  filter(mouse_strain == "CD-1" & cage_number == "2B") %>%
  # pipe into View() to check 
  # but we can't pipe out of this (has to be the last thing)
  View() 

# %in% allows you to provide a set of options for character
# filtering

# we want all mice from cage 1A or 2B
dosage %>%
  filter(cage_number == "1A" | cage_number == "2B")

dosage %>%
  # %in% and then provide a vector of options
  filter(cage_number %in% c("1A", "2B"))

# activity
# find the top 5 longest tails in mice from cages 1A or 2B
dosage %>%
  filter(cage_number %in% c("1A", "2B")) %>%
  slice_max(tail_length_mm, n = 5) %>%
  select(tail_length_mm)


# select (subsetting/picking columns)
# filteR -> rows
# seleCt -> columns

# for example, the drug_dose_g and id_num columns:
dosage %>%
  select(drug_dose_g, id_num)
?select()
# you can also remove columns using -
dosage %>%
  select(-mouse_strain)

# select() vs pull() 
# select() always returns a tibble/data frame
dosage %>%
  select(drug_dose_g) %>%
  class()

# let's say we want to find the mean drug dosage

# this won't work as mean() expects a vector
dosage %>%
  select(drug_dose_g) %>%
  mean()

# the pull() works the same as the $
# it returns a vector
iris$Sepal.Length %>% mean()
iris %>% pull(Sepal.Length) %>% mean()

# find the mean drug dosage
dosage %>%
  filter(!is.na(drug_dose_g)) %>%
  pull(drug_dose_g) %>%
  mean(na.rm = TRUE)

# missing values (NA)
# missing values are contagious
# we often want to remove them or replace them before analysing data
# we can use na.rm argument in many functions 
# (see above)

# we can use filter to remove NA in specific columns
# using is.na() helper function
dosage %>%
  # we need ! to negate otherwise we just get the missing rows
  filter(!is.na(drug_dose_g)) %>%
  pull(drug_dose_g) %>%
  mean()
# don't need mean(na.rm = TRUE) because we have already filtered on the NA's

# you can remove all missing values in all columns with 
# na.omit() function
dosage %>%
  na.omit() %>%
  View()

dosage_1 <- read_delim("~/Library/Mobile Documents/com~apple~CloudDocs/University/BIOL90042/BIOL90042_workshops/data/mousezempic_dosage_data.csv") %>% 
  na.omit() %>% 


# you need to think about your data and what missing values mean
# sometimes you might want to replace missing values with
# a sensible default
# using replace_na()

# let's replace missing values in dosage$sex with 'unknown'
dosage %>%
  replace_na(list(sex = "unknown")) %>%
  View
 

# mutate() function change our data
# usually use it to add new columns

# let's say i want to convert drug_dose_g to drug_dose_mg
dosage$drug_dose_mg <- dosage$drug_dose_g * 1000 

# we can rewrite this using mutate()
dosage %>%
  # syntax: new_column = old_column * something
  mutate(drug_dose_mg = drug_dose_g * 1000) %>%
  # use select() to check the code did what we thought
  select(drug_dose_g, drug_dose_mg)


# mutate allows us to perform complex operations when making new col
# case_when() helper function
# a way to create categories

# let's change weight_lost_g to be categories of 
# low, med, high 

dosage %>%
  mutate(weight_lost_cat = case_when(
    # low is mice that lost less than 4g
    weight_lost_g < 4 ~ "Low",
    # med is mice that lost between 4-5g
    weight_lost_g <= 5 ~ "Medium",
    # high is anything above 5
    weight_lost_g > 5 ~ "High"
  )) %>%
  select(weight_lost_cat, weight_lost_g) %>%
  View()


# activity
# use the beaver1 dataset
beaver1

# create a new column containing the differential from average
# beaver temperature (37c), use mutate syntax

beaver1 %>% as_tibble() %>% # format as tibble so it prints nicer
  mutate(diff_from_av_temp = temp - 37)

# is a beaver more likely to be above the average temperature 
# when it's outside or inside its house? 'activ' column is 0
# when beaver is inside, and 1 when beaver is outside

# we could create a new column that categorises this
# "beaver above average and outside", 
# "beaver below average and outside"

beaver1 %>%
  as_tibble() %>% # format as tibble so it prints nicer
  mutate(diff_from_av_temp = temp - 37,
         beaver_temp_location = case_when(
           diff_from_av_temp > 0 & activ == 0 ~ "beaver above average and inside",
           diff_from_av_temp > 0 & activ == 1 ~ "beaver above average and outside",
           diff_from_av_temp < 0 & activ == 0 ~ "beaver below average and inside",
           diff_from_av_temp < 0 & activ == 1 ~ "beaver below average and outside"
         ))

