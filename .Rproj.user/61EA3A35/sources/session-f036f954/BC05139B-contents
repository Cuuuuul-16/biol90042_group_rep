# summarising and grouping data
# summarising: summarise() or summarize()

# example: average tail length
dosage %>%
  # first remove missing values to make our lives easier
  na.omit() %>%
  # the syntax is similar to mutate, we create new columns
  # by applying functions to existing ones
  summarise(
    av_tail_length = mean(tail_length_mm),
    min_tail_length = min(tail_length_mm),
    # add the max, and median tail length to this summary
    max_tail_length = max(tail_length_mm),
    med_tail_length = median(tail_length_mm)
  )

# in reality, use summary()
summary(dosage$tail_length_mm)

#GROUPING 
#Grouping is a powerful concept in in dplyr that allows you to perform operations on subsets of your data. 
#For example, you might want to calculate the mean weight lost by mice in each cage, 
#or find the mouse with the longest tail in each strain.

# Combining summarising with grouping
dosage %>%
  # first remove missing values to make our lives easier
  na.omit() %>%
  # the syntax is similar to mutate, we create new columns
  # by applying functions to existing ones
  summarise(
    av_tail_length = mean(tail_length_mm),
    min_tail_length = min(tail_length_mm),
    max_tail_length = max(tail_length_mm),
    med_tail_length = median(tail_length_mm),
    # to add grouping, use .by
    .by = mouse_strain
  )
# It’s also possible to group by multiple columns by passing a vector of column names to the .by argument. 
# For example, to calculate the mean weight lost by mice in each cage and strain:
dosage %>%
  na.omit() %>%
  summarise(
    av_weight_lost = mean(weight_lost_g),
    # use n() to get a count of each group
    n_mice = n(),
    # to use multiple columns, give a vector of col names
    .by = c(cage_number, mouse_strain)
  )

# In the dplyr package, there are two ways to group data: 
#using the .by argument within various functions (as we have covered so far), or using the group_by() function, 
#then performing your operations and ungrouping with ungroup().

#Using .by
dosage %>%
  summarise(mean_weight_lost = mean(weight_lost_g, na.rm = TRUE), .by = cage_number)

# Another way to group our data 
# instead of using .by, we can use: 
dosage %>%
  na.omit() %>%
  # supply to group_by() the column(s) you want to group by
  group_by(cage_number, mouse_strain) %>%
  summarise(
    # don't need .by since we already did group_by()
    av_weight_lost = mean(weight_lost_g),
    n_mice = n()
  ) %>%
  # ungroup using ungroup()
  ungroup()

# one handy thing about group_by() is it works outside of summarise
# e.g. in filter() or slice_max()
dosage %>%
  na.omit() %>%
  group_by(cage_number, mouse_strain) %>%
  slice_max(weight_lost_g, n = 1) %>%
  View()
# note that this output is grouped

# activity
# how many mice in each combination of cage_number and 
# mouse_strain lost at least 3g of weight

# hint: first need to group, then use filter, then summarise
dosage %>%
  na.omit() %>%
  group_by(cage_number, mouse_strain) %>%
  filter(weight_lost_g >= 3) %>%
  summarise(count = n())

# data wrangling of genes dataset
# pivot functions allow us to change the shape of our data

# pivot_longer: goes from wide to long data
# example: make 'genes' into long format

long_genes <- genes %>% # don't forget to assign to variable
  pivot_longer(
    # we need to give 3 arguments:
