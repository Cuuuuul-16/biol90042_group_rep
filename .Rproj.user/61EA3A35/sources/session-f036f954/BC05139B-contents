# pivot_wider: fish_encounters
# pivot this so that all of the stations are their own columns
# and the values are whether the fish was seen or not
fish_encounters %>%
  pivot_wider(
    names_from = station,
    values_from = seen,
    # values_fill allows us to provide a value for missing (NA)
    values_fill = 0
  )

# joining datasets (data frames) together with join_ functions
# left_join() is the most commonly used join 

# left_join() needs 3 things
# the 'left' data frame (most important/crucial one)
# the 'right' data frame
# the column to join by (optional)

# let's join 'genes' (right) to 'dosage' (left)
# by default it joins on any columns shared across both datasets
left_join(dosage, genes_tidy)

# we can change this behaviour
left_join(
  dosage,
  genes_tidy,
  # in join functions you use by NOT .by
  by = join_by(id_num),
  # suffix disambiguates same column names you're not joining on
  suffix = c("_biological", "_techinical")
)

# joining things with the same number of rows
left_join(dosage, genes, by = join_by(id_num))

# how to write data to a file
# example, let's write out dosage joined to genes
# first, assign to a variable
joined_data <- left_join(dosage, genes, by = join_by(id_num))

# write data to file using write_csv() or write_tsv()
# usually recommend to use csv file, so write_csv()
write_csv(joined_data, "joined_data.csv")

# can also use this function with pipe
dosage %>%
  # do some data cleaning
  left_join(genes, by = join_by(id_num)) %>%
  write_csv("data/joined_data.csv")


