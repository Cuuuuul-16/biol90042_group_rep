# pivot_wider()
# pivot wider often makes tables a bit easier for us to read
# let's make a contingency table of mouse strain and sex
# first need to count the number in each category

dosage %>%
  summarise(
    n_mice = n(),
    .by = c(mouse_strain, sex)
  ) %>%
  pivot_wider(
    # pivot_wider only needs 2 arguments
    # names_from: the column that the new column names come from
    names_from = sex,
    # values_from: the column that the new values come from
    values_from = n_mice,
  )

#Now that we’ve pivoted it into a long format, our genes data certainly looks a lot better! 
#But, it’s not quite tidy yet; recall that our for data to be tidy, each column should contain only one variable. 
#but our measurement column actually contains two pieces of information: the gene being measured and the replicate number,
#which are separated by an underscore. 
#In order to make our data tidy, we can use the separate() function to split these into columns of their own.

# using the separate() function to split a column
genes_tidy <- long_genes %>%
  # separate measurement column into gene_name and replicate
  separate(
    # first, the column to separate
    measurement,
    # next, what to separate it into
    # these columns don't exist yet so need ""
    into = c("gene_name", "replicate"),
    # what to separate it by
    sep = "_"
  )

