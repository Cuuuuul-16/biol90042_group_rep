install.packages("nycflights13")
library(nycflights13)
library(tidyverse)

#data() function loads datasets from R packages, you won't have to do this in assessment
data(flights)
data(airlines)

#revise some basic dplyr
#Q look more closely at the flights dataset

#Q which five flights have the longest departure delays
flights |> 
  slice_max(dep_delay, n = 5) |> 
  relocate(dep_delay)

#Q What was the overall average departure delay
flights |> 
  pull(dep_delay) |> 
  mean(na.rm = TRUE)
#OR
summary(flights$dep_delay)
#will tell you how many NA's there are

#missing values
#Q how many missing values are in arr_delay

summary(flights$arr_delay)
sum(is.na(flights$arr_delay))
flights |> filter(is.na(arr_delay)) |> nrow()

#Q Replace missing values in dep_delay and arr_delay with 999

flights %>%
  replace_na(list(dep_delay = 999, arr_delay = 999)) %>%
  View()

#Grouped summary
#using summarise(.by...)
#Q: which airlines has the most flights that are delayed for the longest on average
flights |> 
  na.omit() |> 
  summarise(
    av_delay_per_airline = mean(dep_delay),
    .by = carrier
  ) |> 
  arrange(desc(av_delay_per_airline))
 
# usr left_join to join 'airline' to the summarised flights
flights |> 
  summarise(
    av_delay_per_airline = mean(dep_delay, na.rm = TRUE),
    .by = carrier
  ) |> 
  #use left_join() to join it with 'airlines'
  left_join(airlines)

# left_join(df1, df2) is the same as df1 |>  left_join(df2)

#Q: the average departure delay for each combination of airport (origin column)
# and month (month column)
flights_2 <- flights |> 
  na.omit() |> 
  summarise(
    av_dep_delay_airportmonth = mean(dep_delay),
    .by = c(origin, month)
  )

#alternatively
flights |> 
  group_by(origin, month) |> 
  summarise(av_dep_delay = mean(dep_delay, na.rm = TRUE)) |> 
  View()

#reshape this data into a format where i have one column per origin, and one row per month
flights_2 %>%
  na.omit() |> 
  pivot_wider(
    names_from = origin,
    values_from = av_dep_delay_airportmonth
  ) |> 
  arrange(month)

#alternatively
flights |> 
  group_by(origin, month) |> 
  summarise(av_dep_delay = mean(dep_delay, na.rm = TRUE)) |> 
  pivot_wider(names_from = origin, values_from = av_dep_delay)

#pivot_longer
flights %>%
  group_by(origin, month) |> 
  summarise(av_dep_delay = mean(dep_delay, na.rm = TRUE)) |>
  pivot_wider(names_from = origin, values_from = av_dep_delay) |> 
  pivot_longer(
    cols = c(EWR, JFK, LGA),
    names_to = "origin",
    values_to = "av_dep_delay"
  )


