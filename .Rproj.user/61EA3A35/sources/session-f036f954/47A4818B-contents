#One continuous variable and one categorical variable. Asking whether a continuous variable differs between groups
#t-test for 2 groups, ANOVA for 3+ groups

#T-TEST
  #Assumptions
    #observations independent
    #the outcome is approximately normally distributed within each groups. If not, use the non-parametic alternative wilcox.test()
    #the groups have approximately equal variance. If not, use Welch's correction: t.test(..., var.equal = FALSE)

    #BEFORE TESTING, VISUALISE DATA
    
    #actvity:
    # is there a difference in the weight_lost_g between male and female mice?
      
ggplot(
  data = dosage_clean,
  aes(x = sex, y = weight_lost_g)) +
  geom_boxplot() + ylim(0,7)
    #does look like there's some difference between groups
    #does quick look at box plots ensure assumptions are met?

#t-test
#check for normality with a QQ plot
#A QQ (quantile-quantile) plot compares the quantiles of our data against 
#the quantiles we would expect if the data was perfectly normally distributed

ggplot(
  data = dosage,
  aes(sample = weight_lost_g)) +
  geom_qq() + geom_qq_line() + facet_wrap(~sex)
#points deviate from straight line in each group, doesn't follow 
#can confirm this using Shapiro Wilks test

#shapiro.test(), takes a vector of what you're testing
dosage |> 
  filter(sex =="female") |> 
  pull(weight_lost_g) |> 
  shapiro.test()

#p-value less than 0.05, so it's not normal. This means a t-test isn’t actually valid here 
#(we should use the non-parametric alternative wilcox.test() instead), 
#but for the sake of showing you how one works in R, let’s run it anyway.

#assumption of normality is violated, what we should use then is wilcox test, not t.test()
#we'll do both for teaching purposes

# provide functions with: 
t.test(formula, data, var.equal = TRUE)
#formula is: y ~ x, used to define the relationship for statistical test
#weight_lost_g ~ sex
# var.equal = TRUE for a Student’s t-test (assuming variances are equal) 
# or var.equal = FALSE for Welch’s t-test (assuming variances are not equal)

t.test(weight_lost_g ~ sex, data = dosage, var.equal = TRUE)

#the wilcox test works exactly the same way

wilcox.test(weight_lost_g ~ sex, data = dosage, var.equal = TRUE)

# ANOVA (or non parametric kruskal wallace test)
#one continuous and one categorical
#aov() or kruskal.test()
# The t-test only compares two groups, so while we could use it to compare male vs female mice, 
# if we want to compare weight_lost_g across all three mouse strains at once, we need its multi-group extension: 
# the ANOVA (analysis of variance).
# work pretty similarly to t.test and wilxoc.test but they are for when you have 3+ groups

#First, visualise the data
ggplot(dosage, aes(x = mouse_strain, y = weight_lost_g)) + geom_boxplot()

# Note that, just like for the t-test, 
# ANOVA assumes our continuous variable is approximately normally distributed 
# (which we can check using a QQ-plot or Shapiro-Wilks test):
ggplot(dosage, aes(sample = initial_weight_g)) +
  geom_qq() +
  geom_qq_line() +
  # facet because we need to check normality for each group
  facet_wrap(~mouse_strain)

# does weight lost differ across mouse strain?
# when we use the aov() function, we need to run something after it to get a p-value: summary()
aov(weight_lost_g ~ mouse_strain, data = dosage) |> summary()

#may be interested in post-hoc test finding the significance pairwise p values(s)
#Tukey HSD - a way to find out specifically which pairs are significant
aov(weight_lost_g ~ mouse_strain, data = dosage) |> TukeyHSD()
# tells us there is significance between black-6 and BALBC, and CD-1
# but not significance between CD-1 and BALB-C

#Unlike for t.test(), the aov() function doesn’t have an argument for equal variances. 
#If your variances aren’t equal, you need to instead use the oneway.test() function, 
#which does have this argument: 
oneway.test(weight_lost_g ~ mouse_strain, data = dosage, var.equal = FALSE)


#Non parametic tests
#When a parametric assumption (i.e. normality) is badly violated, 
#we can turn to a non-parametric alternative instead. 
#These tests don’t assume the outcome is normally distributed and instead test 
#for differences in the ranks of the data.

#WILCOXON TEST
#The Wilcoxon rank-sum test (also called the Mann-Whitney test when applied on two samples, like we will do here) 
#is the non-parametric equivalent of the t-test we covered earlier. Instead of comparing means, 
#it tests whether one group tends to have overall higher or lower ranked values than the other.
wilcox.test(weight_lost_g ~ sex, data = dosage)

#Kruskal test
#just like the t-test, the Wilcoxon test only compares two groups. 
#The non-parametric version of the ANOVA we ran above is called the Kruskal-Wallis test, 
#and we can run it using the kruskal.test() function:
kruskal.test(weight_lost_g ~ mouse_strain, data = dosage) 

# Correlation between two continuous variables
