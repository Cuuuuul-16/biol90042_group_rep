#direction of a linear relationship between them using a correlation coefficient.


# cor.test
  #Assumptions:
    #Pearson: linear relationship, minimal outliers, normal distribution
    #spearman: monotonic relationship

#find the correlation between weight_lost_g and drug_dose
#First check assumptions by plotting a scatterplot
  ggplot(dosage, aes(x = drug_dose_g, y = weight_lost_g)) +
    geom_point() +
    # add geom_smooth to compare the points to a linear
    # line of best fit
    geom_smooth(method = "lm") +
    labs(
      x = "Drug dose (g)",
      y = "Weight lost (g)",
      title = "Correlation between drug dose and weight lost"
    )
#default method is pearson correlation
cor.test(dosage$weight_lost_g, dosage$drug_dose_g)

#set method using method argument
cor.test(dosage$weight_lost_g, dosage$drug_dose_g, method = "spearman")

# VISUALISING STATISTICAL TESTS WITH GGPUBR
ggboxplot(
  data = dosage,
  # unlike in the ggplot() function, x and y are
  # supplied directly, not in aes()
  x = "sex", y = "weight_lost_g",
  # in ggpubr, you add jitter using the 'add' argument
  add = "jitter") +
  stat_compare_means(method = "t.test") +
  labs(x = "Sex", y = "Weight lost (g)")

#The same idea works for our three-strain comparison, using method = "kruskal.test" (or method = "anova"):
  
  ggboxplot(dosage, x = "mouse_strain", y = "weight_lost_g", add = "jitter") +
  stat_compare_means(method = "kruskal.test") +
  labs(x = "Mouse strain", y = "Weight lost (g)")
  
# We can get ggpubr to add pairwise comparisons too, by supplying a list of the pairs we’re interested in to the comparisons argument:
    
    ggboxplot(dosage, x = "mouse_strain", y = "weight_lost_g", add = "jitter") +
    # get the pairwise comparisons
    stat_compare_means(
      comparisons = list(c("BALBc", "Black6"), c("BALBc", "CD1"), c("Black6", "CD1"))) +
    # get the overall p value and test name
    stat_compare_means(method = "kruskal.test", label.y = 8) +
    labs(x = "Mouse strain", y = "Weight lost (g)")
    
# Similarly to ggboxplot(), ggscatter() is another higher-level plotting function from ggpubr. It creates a scatterplot that we can annotate with stat_cor() to show the correlation coefficient and p value:
      
      ggscatter(dosage, x = "drug_dose_g", y = "weight_lost_g", add = "reg.line") +
      stat_cor(method = "pearson") +
      labs(x = "Drug dose (g)", y = "Weight lost (g)")

#Linear models, can use on either continuous or discrete variables
# when doing simple linear models, y should be continuous but your x can be discrete or continuous
#Assumptions:
  #linearity
  #independence of residuals
  #homscedasticity 
  #residuals are approximately normally distributed

#for example fit a linear model of weight_lost_g and sex - differences between groups
lm(weight_lost_g ~ sex, data = dosage)

#just like for the aov() we need to use summary() to see more info
lm(weight_lost_g ~ sex, data = dosage) |> summary()
#sexmale 4.9e-16 ***
# this answers the question is there a difference between male and female weight lost

#we can also do a linear model to compare both groups against 0
# But what if we don’t want to compare the male vs female mice, 
# and instead are just interested in knowing whether either sex lost a meaningful amount of weight at all? 
# want to know did either sex lose weight overall
#changing our formula to address this question
lm(weight_lost_g ~ 0 + sex, data = dosage) |> summary()
#this answers the question that both female and male mice lost a statistically significant amount of weight
# 0 + sex seperates sex out as a covariate

#linear model between two continuous variables
lm(weight_lost_g ~ drug_dose_g, data = dosage) |> summary()

# how to include covariates to try and account for confounders
# predicting weight lost from drug dosage but also the mouse strain
lm(weight_lost_g ~ drug_dose_g + mouse_strain, data = dosage_clean) |> summary()

dosage |> ggplot(aes(x = mouse_strain, y = initial_weight_g)) + geom_boxplot()

