load("~/Library/Mobile Documents/com~apple~CloudDocs/University/BIOL90042/BIOL90042_Group_Project/group3_data/prs.Rda")
load("~/Library/Mobile Documents/com~apple~CloudDocs/University/BIOL90042/BIOL90042_Group_Project/group3_data/gait.Rda")
